---
layout: base.njk
bodyClass: page-dest
currentNav: lavitsa
---

<a class="back-link" href="/"
   data-transition data-label="МЕРИДИАН" data-symbol="✦">
  <span>←</span>към звездите
</a>

<div class="page-header">
  <div class="page-symbol">
    <img src="/img/svg/candle.svg" alt="">
  </div>
  <div class="page-rule top"></div>
  <h2>ЛАВИЦА</h2>
  <div class="page-sub">Ultima Thule</div>
  <div class="page-rule bottom"></div>
</div>

{% include "partials/mini-nav.njk" %}

<div class="lavitsa-content">

  <p class="lavitsa-intro">
    Тук ще откриете... Всеки кораб се нуждае от пристан. Този е нашия.
  </p>

  {# ── Favorites carousel ── #}
  <div class="lavitsa-section">
    <h3 class="lavitsa-section-title">Последни фаворити:</h3>

    <div class="lavitsa-carousel" aria-label="Избрани книги">
      <button class="carousel-arrow carousel-prev" aria-label="Предишна книга">‹</button>

      <div class="carousel-stage">
        {%- for book in lavitsa.favorites -%}
        <div class="carousel-card" data-index="{{ loop.index0 }}">
          <div class="carousel-card-inner">
            <div class="carousel-face carousel-front">
              {%- if book.cover -%}
              <img src="{{ book.cover }}" alt="{{ book.title }}" loading="lazy">
              {%- else -%}
              <div class="carousel-cover-fallback">
                <span class="carousel-fallback-letter">{{ book.letter }}</span>
              </div>
              {%- endif -%}
            </div>
            <div class="carousel-face carousel-back">
              <div class="carousel-back-title">{{ book.title }}</div>
              <div class="carousel-back-author">{{ book.author }}</div>
              <div class="carousel-back-year">{{ book.year }}</div>
              <span class="carousel-back-sep"></span>
              {%- if book.note -%}
              <div class="carousel-back-note">{{ book.note }}</div>
              {%- endif -%}
              <div class="carousel-back-added">Препоръчано от: {{ book.addedBy }}</div>
            </div>
          </div>
          <div class="carousel-flip-hint">обърни</div>
        </div>
        {%- endfor -%}
      </div>

      <button class="carousel-arrow carousel-next" aria-label="Следваща книга">›</button>
    </div>

    <div class="carousel-indicator">
      {%- for book in lavitsa.favorites -%}
      <span class="carousel-dot{% if loop.first %} active{% endif %}"></span>
      {%- endfor -%}
    </div>
  </div>

  <div class="codex-sigil"></div>

  {# ── Full book list ── #}
  <div class="lavitsa-section">
    <h3 class="lavitsa-section-title">100-те най-добри книги<br>според списание Меридиан:</h3>
    <div class="lavitsa-shelf">
      {%- for book in lavitsa.books -%}
      <div class="lavitsa-book">
        <div class="lavitsa-book-primary">
          <div class="lavitsa-cover">
            {%- if book.cover -%}
            <img src="{{ book.cover }}" alt="{{ book.title }}" loading="lazy">
            {%- else -%}
            <div class="lavitsa-cover-fallback">
              <span class="lavitsa-cover-fallback-letter">{{ book.letter }}</span>
            </div>
            {%- endif -%}
          </div>
          <div class="lavitsa-book-meta">
            <div class="lavitsa-book-num">{{ loop.index | pad }}</div>
            <div class="lavitsa-book-title">{{ book.title }}</div>
            <div class="lavitsa-book-author">{{ book.author }}</div>
            <div class="lavitsa-book-year">{{ book.year }}</div>
            <div class="lavitsa-book-added">{{ book.addedBy }}</div>
          </div>
        </div>
        <div class="lavitsa-book-note">
          {{ book.note }}
        </div>
      </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="lavitsa-sigil">✦</div>

</div>