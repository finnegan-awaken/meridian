<!DOCTYPE html>
<html lang="bg">
<head>
  {% include "partials/head.njk" %}
  <script>window.BASE = "{{ '/' | url }}";</script>
  <script>
  (function(){try{var t=localStorage.getItem('meridian-theme');if(t&&(t==='light'||t==='reading'))document.documentElement.setAttribute('data-theme',t)}catch(e){}})();
  </script>
  <link rel="stylesheet" href="/css/themes.css">
  <link rel="stylesheet" href="/css/theme-switcher.css">
</head>
<body class="{{ bodyClass | default('page-dest') }}">

  {{ content | safe }}

  {% if "page-nav" in bodyClass %}
  {% include "partials/tarot.njk" %}
  {% endif %}

  <!-- Transition overlay — starts active to prevent flash -->
  <div id="transition" class="active no-transition">
    <div id="transition-symbol"></div>
    <div id="transition-text"></div>
  </div>
  <script>
    if (!sessionStorage.getItem('meridian-transit')) {
      document.getElementById('transition').classList.remove('active', 'no-transition');
    }
  </script>

  <div id="grain" aria-hidden="true"></div>

  <script src="/js/shared.js"></script>
  {% if "page-nav" in bodyClass %}
  <script src="/js/cosmos.js"></script>
  <script src="/js/nav.js"></script>
  <script src="/js/tarot.js"></script>
  {% endif %}
  {% if "page-dest" in bodyClass %}
  <script src="/js/archive.js"></script>
  {% endif %}
  <script src="/js/carousel.js" defer></script>
  <script src="/js/theme-switcher.js"></script>
  <script src="/js/line-breaks.js"></script>
  <script src="/js/popups.js"></script>

{%- if bodyClass !== "page-nav" -%}
<footer class="site-copyright">
  © 2025 Списание Меридиан.<br class="copyright-break"> Всички права запазени.
</footer>

{%- endif -%}
</body>
</html>