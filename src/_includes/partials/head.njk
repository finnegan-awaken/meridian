<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% if pageTitle %}{{ pageTitle }} — {% endif %}{{ site.title }}</title>
<meta name="description" content="{{ description | default(site.subtitle) }}">

<!-- Favicon -->
<link rel="icon" href="/img/favicon.ico" sizes="any">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">

<!-- Open Graph -->
<meta property="og:title" content="{{ title | default(site.title) }}">
<meta property="og:description" content="{{ description | default(excerpt) | default(site.subtitle) }}">
<meta property="og:image" content="{{ thumb | default(cover) | default('/img/default-og.jpg') }}">
<meta property="og:url" content="{{ page.url }}">
<meta property="og:type" content="article">
<meta property="og:site_name" content="{{ site.title }}">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Bona+Nova:ital,wght@0,400;0,700;1,400&family=Cormorant+Infant:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&display=swap">
<link href="https://fonts.googleapis.com/css2?family=Bona+Nova:ital,wght@0,400;0,700;1,400&family=Cormorant+Infant:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&display=swap" rel="stylesheet">
<link rel="preload" href="/fonts/LinguisticsPro-Regular.otf" as="font" type="font/otf" crossorigin>

<link rel="stylesheet" href="/css/meridian.css">
{% if "page-nav" in bodyClass %}
<link rel="stylesheet" href="/css/tarot.css">
{# <link rel="stylesheet" href="/css/easteregg.css"> #}
{% endif %}
{# {% if "page-book" in bodyClass %}
<link rel="stylesheet" href="/css/book.css">
{% endif %} #}