---
layout: base.njk
bodyClass: page-dest page-book
permalink: /book-of-secrets/
---

{# ── Reusable macro for rendering any page type ── #}
{%- macro renderPage(page) -%}
  {%- if page.type == "text" -%}
    <div class="page-number">{{ page.title }}</div>
    <div class="page-rule-top"></div>
    <div class="page-text-body">
      {%- if page.content is string -%}
        <p class="page-text">{{ page.content }}</p>
      {%- else -%}
        {%- for para in page.content -%}
          <p class="page-text{% if not loop.first %} page-text-continued{% endif %}">{{ para }}</p>
        {%- endfor -%}
      {%- endif -%}
    </div>
    <div class="page-rule-bottom"></div>
    <div class="page-ornament">✦</div>
  {%- elif page.type == "title" -%}
    <div class="page-number">{{ page.title }}</div>
    <h2 class="page-heading">{{ page.heading }}</h2>
  {%- elif page.type == "brotherhood" -%}
    <div class="page-number">{{ page.title }}</div>
    <div class="page-rule-top"></div>
    <div class="brotherhood-content">
      <div class="brotherhood-symbol">⍟</div>
      <h2 class="brotherhood-title">Присъедини се към братството</h2>
      <div class="brotherhood-sub">на Лилавия Бор</div>
      <div class="brotherhood-rule"></div>
      <div class="brotherhood-cta">Стани един от нас</div>
      <div class="brotherhood-coords">42°41'19.3"N · 23°17'50.7"E</div>
    </div>
    <div class="page-ornament">✦</div>


  {%- elif page.type == "image" -%}
    <div class="page-number">{{ page.title }}</div>
    <div class="page-rule-top"></div>
    <div class="page-image-frame">
      <div class="page-image-border"></div>
      <img class="page-image" src="{{ page.image }}" alt="{{ page.caption or '' }}" loading="lazy">
    </div>
    {%- if page.caption -%}
      <p class="page-caption">{{ page.caption }}</p>
    {%- endif -%}
    <div class="page-rule-bottom"></div>
    <div class="page-ornament">✦</div>



  {%- endif -%}
{%- endmacro -%}

<div class="book-scene">
  <div class="book-container">

    {# ── LEFT/RIGHT displays are created by JS ── #}

    <div class="book">

      {# ── SHEET 0: Cover ── #}
      <div class="book-page" data-sheet="0">
        <div class="book-page-front book-cover-front">
          <div class="cover-border"></div>
          <div class="cover-ornament-top">✵</div>
          <div class="cover-image-container">
            <img src="/img/purple-pine.jpg" alt=""
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
            <div class="cover-image-fallback">
              <div class="cover-fallback-symbol">⍟</div>
            </div>
          </div>
          <h1 class="cover-title">КНИГА НА <br>ЗАГАДКИТЕ</h1>
          <div class="cover-rule"></div>
          <div class="cover-sub">Liber Аrcanum</div>
          <div class="cover-ornament-bottom"></div>
        </div>
        <div class="book-page-back">
          <div class="endpaper">
            <div class="endpaper-frame-outer"></div>
            <div class="endpaper-frame-inner"></div>
            <div class="endpaper-center">
              <img src="/img/endpaper.jpg" alt="" class="endpaper-image">
              <span class="endpaper-ornament">❧</span>
            </div>
          </div>
        </div>
      </div>

      {# ── CONTENT SHEETS: pair pages into sheets ── #}
      {%- for i in range(0, book.pages | length, 2) -%}
        <div class="book-page" data-sheet="{{ loop.index }}">

          {# FRONT: right-side page (pages[i]) #}
          <div class="book-page-front">
            <div class="page-parchment"></div>
            <div class="page-content">
              {{ renderPage(book.pages[i]) }}
            </div>
          </div>

          {# BACK: left-side page when this sheet is flipped (pages[i+1]) #}
          <div class="book-page-back">
            <div class="page-parchment"></div>
            <div class="page-content">
              {%- if i + 1 < book.pages | length -%}
                {{ renderPage(book.pages[i + 1]) }}
              {%- else -%}
                <div class="page-ornament" style="margin:auto">✦</div>
              {%- endif -%}
            </div>
          </div>

        </div>
      {%- endfor -%}

      {# ── FINAL SHEET: Rear Endpaper + Back Cover ── #}
      {%- set finalSheetNum = ((book.pages | length / 2) | round(0, 'ceil')) + 1 -%}
      <div class="book-page" data-sheet="{{ finalSheetNum }}">
        <div class="book-page-front">
          <div class="endpaper">
            <div class="endpaper-frame-outer"></div>
            <div class="endpaper-frame-inner"></div>
            <div class="endpaper-center">
              <img src="/img/endpaper.jpg" alt="" class="endpaper-image">
              <span class="endpaper-ornament">❧</span>
            </div>
          </div>
        </div>
        <div class="book-page-back book-cover-back">
          <div class="back-cover-inner">
            <div class="cover-border"></div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <div class="book-nav-hint">
    <span class="book-hint-text"> Виж какво се крие отвъд </span>
  </div>

<a class="book-close" href="/"
     data-transition data-label="МЕРИДИАН" data-symbol="✦">
    ✕
  </a>
</div>